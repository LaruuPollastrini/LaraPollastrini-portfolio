<section
  id="contacto"
  aria-labelledby="contacto-titulo"
  class="mx-auto max-w-5xl px-4 py-12 md:py-16"
>
  <h2 id="contacto-titulo" class="text-3xl font-semibold">Contacto</h2>

  <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
    Si querés charlar sobre una oportunidad o un proyecto, escribime.
  </p>

  <dl class="mt-8 max-w-3xl">
    <div class="grid gap-1 py-3 md:grid-cols-[10rem_1fr] md:gap-6">
      <dt class="font-medium text-accent">Email</dt>
      <dd>
        <a
          href="mailto:Pollastrini.laru@gmail.com"
          class="underline underline-offset-4 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
        >
          Pollastrini.laru@gmail.com
        </a>
      </dd>
    </div>
    <div class="grid gap-1 py-3 md:grid-cols-[10rem_1fr] md:gap-6">
      <dt class="font-medium text-accent">GitHub</dt>
      <dd>
        <a
          href="https://github.com/LaruuPollastrini"
          target="_blank"
          rel="noopener noreferrer"
          class="underline underline-offset-4 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
        >
          github.com/LaruuPollastrini
        </a>
      </dd>
    </div>
    <div class="grid gap-1 py-3 md:grid-cols-[10rem_1fr] md:gap-6">
      <dt class="font-medium text-accent">LinkedIn</dt>
      <dd>
        <a
          href="https://www.linkedin.com/in/lara-pollastrini-0a0956207/"
          target="_blank"
          rel="noopener noreferrer"
          class="underline underline-offset-4 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
        >
          linkedin.com/in/lara-pollastrini
        </a>
      </dd>
    </div>
  </dl>
</section>