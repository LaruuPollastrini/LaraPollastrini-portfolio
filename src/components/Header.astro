---
const links = [
  { href: '#inicio', label: 'Inicio' },
  { href: '#sobre-mi', label: 'Sobre mí' },
  { href: '#proyectos', label: 'Proyectos' },
  { href: '#contacto', label: 'Contacto' },
];
---

<header class="sticky top-0 z-50 border-b border-line bg-bg/90 backdrop-blur">
  <nav
    aria-label="Principal"
    class="mx-auto flex max-w-5xl flex-wrap items-center justify-between px-4 py-3"
  >
    <a
      href="#inicio"
      class="font-semibold tracking-tight focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
    >
      Lara Pollastrini
    </a>

    <div class="flex items-center gap-2 md:order-last md:ml-6">
      <button
        id="theme-toggle"
        type="button"
        aria-label="Cambiar a modo oscuro"
        class="rounded border border-line p-2 text-muted hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        <svg
          class="h-5 w-5 dark:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
        <svg
          class="hidden h-5 w-5 dark:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
      </button>

      <button
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="menu"
        aria-label="Abrir menú"
        class="rounded border border-line px-3 py-2 text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent md:hidden"
      >
        Menú
      </button>
    </div>

    <ul
      id="menu"
      class="hidden w-full flex-col gap-1 pt-3 md:flex md:w-auto md:flex-row md:gap-6 md:pt-0"
    >
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="block py-2 text-muted hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  // Menú desplegable (mobile)
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu');

  function setOpen(open: boolean) {
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    menu?.classList.toggle('hidden', !open);
  }

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  menu?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => setOpen(false));
  });

  // Modo claro / oscuro
  const themeToggle = document.getElementById('theme-toggle');

  function updateThemeLabel() {
    const isDark = document.documentElement.classList.contains('dark');
    themeToggle?.setAttribute(
      'aria-label',
      isDark ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro'
    );
  }

  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    } catch (e) {}
    updateThemeLabel();
  });

  updateThemeLabel();
</script>