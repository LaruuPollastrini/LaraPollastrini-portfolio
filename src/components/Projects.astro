---
import { projects } from '../data/projects.js';
---

<section
  id="proyectos"
  aria-labelledby="proyectos-titulo"
  class="mx-auto max-w-5xl px-4 py-12 md:py-16"
>
  <h2 id="proyectos-titulo" class="text-3xl font-semibold">Proyectos</h2>

  <ul class="mt-8 max-w-3xl space-y-12">
    {
      projects.map((project) => (
        <li>
          <h3 class="text-xl font-semibold">{project.title}</h3>
          <p class="mt-3 leading-relaxed text-muted">{project.description}</p>
          <p class="mt-3 text-sm">
            <span class="font-medium text-accent">Tecnologías: </span>
            {project.technologies.join(', ')}
          </p>
          <p class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
            {project.demo && (
              <a
                href={project.demo}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Ver demo de ${project.title} (se abre en una pestaña nueva)`}
                class="font-medium text-accent underline underline-offset-4 hover:opacity-80 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
              >
                Ver demo
              </a>
            )}
            <a
              href={project.repo}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Ver código de ${project.title} en GitHub (se abre en una pestaña nueva)`}
              class="font-medium text-accent underline underline-offset-4 hover:opacity-80 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
            >
              Ver código
            </a>
          </p>
        </li>
      ))
    }
  </ul>
</section>