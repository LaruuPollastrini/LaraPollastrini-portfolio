---
---

<section
  id="inicio"
  aria-labelledby="hero-titulo"
  class="mx-auto grid max-w-5xl items-center gap-10 px-4 py-16 md:grid-cols-2 md:py-24"
>
  <div class="order-last md:order-first">
    <p class="text-sm uppercase tracking-widest text-muted">
      Desarrolladora Web Full Stack Jr. | Estudiante de Ingeniería en Sistemas
    </p>
    <h1 id="hero-titulo" class="mt-4 text-4xl font-semibold leading-tight md:text-5xl">
      Lara Pollastrini
    </h1>
    <p class="mt-4 max-w-md text-lg text-muted">
      Construyo aplicaciones web que unen una buena experiencia de usuario con una lógica de negocio sólida.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="#proyectos"
        class="rounded border border-accent bg-accent px-5 py-2.5 font-medium text-bg hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
      >
        Ver proyectos
      </a>
      <a
        href="#contacto"
        class="rounded border border-accent px-5 py-2.5 font-medium text-accent hover:bg-surface focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
      >
        Contactarme
      </a>
    </div>
  </div>

  <img
    src="/avatar.webp"
    alt="Retrato de Lara Pollastrini, de frente, con blazer negro y fondo claro"
    width="800"
    height="800"
    fetchpriority="high"
    class="mx-auto aspect-square w-64 rounded-t-full rounded-b-3xl border border-line object-cover md:w-80"
  />
</section>