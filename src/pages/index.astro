---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
---

<Layout
  title="Lara Pollastrini | Desarrolladora Web Full Stack"
  description="Portfolio de Lara Pollastrini, desarrolladora web full stack y estudiante de Ingeniería en Sistemas Informáticos."
>
  <Hero />
  <About />
  <section id="proyectos" class="mx-auto min-h-screen max-w-5xl px-4 py-16">
    <h2 class="text-3xl font-semibold">Proyectos</h2>
  </section>
  <section id="contacto" class="mx-auto min-h-screen max-w-5xl px-4 py-16">
    <h2 class="text-3xl font-semibold">Contacto</h2>
  </section>
</Layout>